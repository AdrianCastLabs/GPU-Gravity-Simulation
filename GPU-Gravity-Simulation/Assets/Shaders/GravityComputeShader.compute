#pragma kernel ComputeGravity

RWStructuredBuffer<float2> positions;
RWStructuredBuffer<float2> velocities;

int nParticles;
float gravity;
float smoothingRadius;
float mass;
float dt;

[numthreads(64,1,1)]
void ComputeGravity(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)nParticles) return;

    float2 pos = positions[id.x];
    float2 force = float2(0,0);

    for (uint i = 0; i < (uint)nParticles; i++)
    {
        if (i == id.x) continue;

        float2 dir = positions[i] - pos;
        float distSq = dot(dir, dir) + smoothingRadius * smoothingRadius;
        float invDist = rsqrt(distSq);

        force += dir * invDist * invDist * invDist * (gravity * mass * mass);
    }

    velocities[id.x] += force * dt / mass;
    positions[id.x] = pos + velocities[id.x] * dt;
}